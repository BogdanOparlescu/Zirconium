<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="clr-namespace:Zirconium.UI"
    xmlns:vm="clr-namespace:Zirconium.ViewModels"
    x:Class="Zirconium.UI.ChatView"
    x:DataType="ui:Chat"
    x:CompileBindings="True">

    <Grid>
          <!--<Image Source="avares://Zirconium/UI/octo.png"
           Stretch="None"
           Opacity="1"
           Height="800"
           IsHitTestVisible="False"/>-->
           <Viewbox HorizontalAlignment="Center" VerticalAlignment="Center" Stretch="Uniform">
               <TextBlock x:Name="_OctoAsciiArt"
               FontFamily="avares://Zirconium/UI/consola.ttf#C"
               FontSize="5"
               LineHeight="5"
               Foreground="GhostWhite"
               TextWrapping="NoWrap"
               IsHitTestVisible="False"
               HorizontalAlignment="Center"
               VerticalAlignment="Center"
               Height="480"
               Padding="20"/>
           </Viewbox>

        <Border Background="#B0000000"
                IsHitTestVisible="False" />

        <Border x:Name="_CallStackPanel"
                IsVisible="False"
                Background="#0A0A0A"
                BorderBrush="#222222"
                BorderThickness="1,0,0,0">
            <TextBox x:Name="_CallStack"
                     IsReadOnly="True"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     Background="#0A0A0A"
                     Foreground="#EAEAEA"
                     BorderThickness="0"
                     Padding="10"
                     FontFamily="Consolas, Courier New, monospace"
                     FontSize="12"
                     TextBlock.TextWrapping="Wrap"/>
        </Border>

        <Grid Grid.Column="0"
              RowDefinitions="*,Auto"
              Background="Transparent">

            <ScrollViewer x:Name="ChatScroll"
                          Grid.Row="0"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">

                <Border MaxWidth="400"
                        HorizontalAlignment="Center"
                        Margin="20,28,20,20">

                    <ItemsControl ItemsSource="{Binding Messages}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="ui:ChatMessage">

                                <Grid Margin="0,10"
                                      ColumnDefinitions="140,*,140">

                                    <ExperimentalAcrylicBorder Grid.ColumnSpan="3"
                                                               HorizontalAlignment="{Binding IsUser, Converter={StaticResource AlignConverter}}"
                                                               MaxWidth="700"
                                                               Padding="16"
                                                               CornerRadius="18">

                                        <ExperimentalAcrylicBorder.Material>
                                            <ExperimentalAcrylicMaterial BackgroundSource="Digger"
                                                                          TintColor="DarkBlue"/> <!--blue-->
                                        </ExperimentalAcrylicBorder.Material>

                                        <SelectableTextBlock Text="{Binding Content}"
                                                             TextWrapping="Wrap"
                                                             Foreground="#F0F0F0" />
                                    </ExperimentalAcrylicBorder>

                                </Grid>

                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                </Border>
            </ScrollViewer>

            <Border Grid.Row="1"
                    Background="#090909"
                    BorderBrush="#222222"
                    BorderThickness="1,1,0,0"
                    Padding="14">

                <Border MaxWidth="980"
                        HorizontalAlignment="Center">
                    <StackPanel Orientation="Vertical" Spacing="6" VerticalAlignment="Top">
                        <TextBlock x:Name="ModelLabel"
                                   Text="Model: —"
                                   FontSize="11"
                                   Foreground="#888888"
                                   HorizontalAlignment="Left"
                                   Margin="2,0,0,0"/>
                        <Grid ColumnDefinitions="*,Auto,Auto">
                            <TextBox x:Name="PromptBox"
                                     Text="{Binding Prompt}"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     MinHeight="42"
                                     MaxHeight="140"
                                     Background="#141414"
                                     Foreground="#EAEAEA"
                                     CaretBrush="#EAEAEA"
                                     BorderThickness="1"
                                     BorderBrush="#2A2A2A"
                                     Padding="14"
                                     PlaceholderText="Message..." />

                            <Button Grid.Column="1"
                                    x:Name="SendButton"
                                    Content="→"
                                    Width="44"
                                    Height="44"
                                    Margin="10,0,0,0"
                                    Background="#141414"
                                    BorderBrush="#2A2A2A"
                                    BorderThickness="1"
                                    Foreground="#EAEAEA"
                                    Click="SendClicked" />

                            <Button Grid.Column="2"
                                    x:Name="ModelSelectorButton"
                                    Content="^"
                                    Width="32"
                                    Height="44"
                                    Margin="6,0,0,0"
                                    FontSize="12"
                                    Background="#141414"
                                    BorderBrush="#2A2A2A"
                                    BorderThickness="1"
                                    Foreground="#EAEAEA"
                                    Click="ModelSelectorClicked" />
                        </Grid>
                    </StackPanel>
                </Border>
            </Border>

        </Grid>

        <Popup x:Name="ModelPopup"
        IsLightDismissEnabled="True"
        Placement="Bottom"
        HorizontalOffset="0"
        VerticalOffset="0">
            <Border Background="#000000"
                BorderBrush="#333333"
                BorderThickness="1"
                CornerRadius="6"
                Width="260"
                MaxHeight="400"
                ClipToBounds="True">
            <ScrollViewer x:Name="ModelScroll"
                            HorizontalScrollBarVisibility="Disabled"
                            VerticalScrollBarVisibility="Auto"/>
            </Border>
        </Popup>

    </Grid>
</UserControl>