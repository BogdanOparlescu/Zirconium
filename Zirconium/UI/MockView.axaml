<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="clr-namespace:Zirconium.UI"
    xmlns:vm="clr-namespace:Zirconium.ViewModels"
    x:Class="Zirconium.UI.MockView"
    x:DataType="ui:Chat"
    x:CompileBindings="True">

    <Grid>
          <Image Source="avares://Zirconium/UI/octo.png"
           Stretch="None"
           Opacity="1"
           Height="800"
           IsHitTestVisible="False"/>

        <Border Background="#B0000000"
                IsHitTestVisible="False" />

        <Grid RowDefinitions="*,Auto"
              Background="Transparent">

            <ScrollViewer x:Name="ChatScroll"
                          Grid.Row="0"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">

                <Border MaxWidth="400"
                        HorizontalAlignment="Center"
                        Margin="20,28,20,20">

                    <ItemsControl ItemsSource="{Binding Messages}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="ui:ChatMessage">

                                <Grid Margin="0,10"
                                      ColumnDefinitions="140,*,140">

                                    <ExperimentalAcrylicBorder Grid.ColumnSpan="3"
                                                               HorizontalAlignment="{Binding IsUser, Converter={StaticResource AlignConverter}}"
                                                               MaxWidth="700"
                                                               Padding="16"
                                                               CornerRadius="18">

                                        <ExperimentalAcrylicBorder.Material>
                                            <ExperimentalAcrylicMaterial BackgroundSource="Digger"
                                                                          TintColor="blue"/>
                                        </ExperimentalAcrylicBorder.Material>

                                        <SelectableTextBlock Text="{Binding Content}"
                                                             TextWrapping="Wrap"
                                                             Foreground="#F0F0F0" />
                                    </ExperimentalAcrylicBorder>

                                </Grid>

                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                </Border>
            </ScrollViewer>

            <Border Grid.Row="1"
                    Background="#090909"
                    BorderBrush="#222222"
                    BorderThickness="1,1,0,0"
                    Padding="14">

                <Border MaxWidth="980"
                        HorizontalAlignment="Center">

                    <Grid ColumnDefinitions="*,Auto">

                        <TextBox x:Name="PromptBox"
                                 Text="{Binding Prompt}"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 MinHeight="42"
                                 MaxHeight="140"
                                 Background="#141414"
                                 Foreground="#EAEAEA"
                                 CaretBrush="#EAEAEA"
                                 BorderThickness="1"
                                 BorderBrush="#2A2A2A"
                                 Padding="14"
                                 Watermark="Message..." />

                        <Button Grid.Column="1"
                                x:Name="SendButton"
                                Content="→"
                                Width="44"
                                Height="44"
                                Margin="10,0,0,0"
                                Background="#141414"
                                BorderBrush="#2A2A2A"
                                BorderThickness="1"
                                Foreground="#EAEAEA"
                                Click="SendClicked" />

                    </Grid>
                </Border>
            </Border>

        </Grid>
    </Grid>
</UserControl>